# ==========================================================================
#  El AGENTE (generación + tool calling) corre sobre UNO de tres motores.
#  Se elige por prioridad: Ollama > Groq > Gemini.
# ==========================================================================

# --- Opción 1: OLLAMA (modelo local, ej. en la Mac de un compañero) --------
# Sin cuota, sin costo, los datos no salen de la máquina. RAG 100% local.
# En la Mac: 'ollama serve', y baja el modelo de chat + el de embeddings:
#   ollama pull qwen2.5:7b   &&   ollama pull bge-m3
# OLLAMA_HOST=localhost:11434
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_EMBED_MODEL=bge-m3        # embeddings locales para el RAG (multilingüe)
# OLLAMA_NUM_CTX=8192             # ventana de contexto (sube para charlas largas)

# --- Opción 2: GROQ (nube gratuita, cuota generosa, muy rápido) ------------
# Llave gratis sin tarjeta: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Gemini: embeddings del RAG y visión (foto de placa) -------------------
# Si no hay cuota, el RAG cae a BM25 y la visión queda deshabilitada.
# Llave gratis sin tarjeta: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# El agente rota entre varias llaves de Gemini si una se agota:
# GOOGLE_API_KEY_2=segunda_llave
# GOOGLE_API_KEYS=llave1,llave2,llave3
